{
  "version": 4,
  "rules": [
    {
      "id": "codex-context",
      "enabled": true,
      "matchBundleId": ["com.openai.codex", "com.openai.chat", "com.perplexity.comet"],
      "matchDomain": ["chatgpt.com", "chat.openai.com", "perplexity.ai"],
      "tags": ["#capture", "#codex"],
      "urlStrategy": "selection-then-clipboard-then-frontmost",
      "outputFormat": "- [ ] $selection\n  - cwd: $cwd\n  - git: $gitRoot\n  - branch: $gitBranch\n  - status: $gitStatus #capture #codex",
      "fallbackFormat": "- [ ] $selection #capture",
      "match": { "domains": ["chatgpt.com", "chat.openai.com", "perplexity.ai"] },
      "title": { "fallback": "Codex Context" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    },
    {
      "id": "llm-gpt",
      "enabled": true,
      "matchBundleId": ["com.openai.chat"],
      "matchDomain": ["chatgpt.com", "chat.openai.com"],
      "tags": ["#LLM", "#GPT"],
      "urlStrategy": "frontmost-then-selection-then-clipboard",
      "outputFormat": "* [$title]($url) #LLM #GPT",
      "fallbackFormat": "* $selection #LLM #GPT",
      "match": { "domains": ["chatgpt.com", "chat.openai.com"] },
      "title": { "fallback": "GPT Chat" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    },
    {
      "id": "llm-perplexity-task",
      "enabled": true,
      "matchBundleId": ["com.perplexity.comet"],
      "matchDomain": ["perplexity.ai"],
      "tags": ["#LLM", "#Perplexity"],
      "urlStrategy": "selection-then-clipboard-then-frontmost",
      "outputFormat": "* [$title]($url) #LLM #Perplexity",
      "fallbackFormat": "* $selection #LLM #Perplexity",
      "match": { "domains": ["perplexity.ai"], "pathContains": ["/computer/tasks/"] },
      "title": { "fallback": "Perplexity Task" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    },
    {
      "id": "llm-perplexity",
      "enabled": true,
      "matchDomain": ["perplexity.ai"],
      "tags": ["#LLM", "#Perplexity"],
      "urlStrategy": "frontmost-then-clipboard",
      "outputFormat": "* [$title]($url) #LLM #Perplexity",
      "fallbackFormat": "* $selection #LLM #Perplexity",
      "match": { "domains": ["perplexity.ai"] },
      "title": { "fallback": "Perplexity" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    },
    {
      "id": "llm-claude",
      "enabled": true,
      "matchBundleId": ["com.anthropic.claudefordesktop"],
      "matchDomain": ["claude.ai"],
      "tags": ["#LLM", "#Claude"],
      "urlStrategy": "frontmost-then-selection-then-clipboard",
      "outputFormat": "* [$title]($url) #LLM #Claude",
      "fallbackFormat": "* $selection #LLM #Claude",
      "match": { "domains": ["claude.ai"] },
      "title": { "fallback": "Claude Chat" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    },
    {
      "id": "browser-generic",
      "enabled": true,
      "matchBundleId": ["com.google.Chrome", "com.apple.Safari", "org.mozilla.firefox", "company.thebrowser.Browser"],
      "tags": ["#capture"],
      "urlStrategy": "frontmost-then-clipboard-then-plain",
      "outputFormat": "* [$title]($url) #capture",
      "fallbackFormat": "* $selection #capture",
      "match": { "domains": [] },
      "title": { "fallback": "Navigateur" },
      "destination": { "engine": "noteplan", "type": "slot" },
      "format": "linkTask",
      "source": "textOnly"
    }
  ]
}
